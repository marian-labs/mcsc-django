# Django settings for MCSC project.
SECRET_KEY=your-secret-key-here
DEBUG=False
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (Shared Infra PostgreSQL)
USE_POSTGRES=true
POSTGRES_DB=mcsc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=infra-postgres
POSTGRES_PORT=5432

# Supabase Storage Configuration
USE_SUPABASE_STORAGE=True
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET_NAME=mcsc-media
SUPABASE_ACCESS_KEY_ID=your-supabase-access-key-id
SUPABASE_SECRET_ACCESS_KEY=your-supabase-secret-access-key

# Google OAuth2 Configuration
GOOGLE_OAUTH2_KEY=your-google-oauth2-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_SECRET=your-google-oauth2-client-secret
RESEND_API_KEY=re_your_api_key_here
# Production sender email with your custom domain
RESEND_FROM_EMAIL=MCSC Students Council <no-reply@yourdomain.com>

PROTECTED_ADMIN_USERNAMES=mcsc_admin,sinan
PYQ_PORTAL_URL=https://pyq.marian.cloud/
