DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-here
PORT=8000
WEB_CONCURRENCY=3
GUNICORN_THREADS=2
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,123.45.67.89
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database Configuration (VPS PostgreSQL + PgBouncer)
DATABASE_URL=postgresql://mcsc_user:your_db_password@db_pooler:6432/mcsc_db
DB_CONN_MAX_AGE=600
POSTGRES_DB=mcsc_db
POSTGRES_USER=mcsc_user
POSTGRES_PASSWORD=your_db_password

# Google OAuth2 Authentication
GOOGLE_OAUTH2_KEY=your-google-oauth2-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_SECRET=your-google-oauth2-client-secret

# Email Notifications (Resend API)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=MCSC Students Council <no-reply@yourdomain.com>

# Administrative & Feature URLs
PROTECTED_ADMIN_USERNAMES=mcsc_admin,sinan
PYQ_PORTAL_URL=https://pyq.marian.cloud/

